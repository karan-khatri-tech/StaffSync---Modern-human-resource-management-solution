# Database Configuration
# MongoDB connection URI (e.g. mongodb://localhost:27017/staffsync or mongodb+srv://<user>:<password>@cluster.mongodb.net/staffsync)
# If left empty, StaffSync seamlessly falls back to persistent atomic JSON file storage (data/staffsync_db.json).
MONGODB_URI="mongodb://localhost:27017/staffsync"

# Authentication & Session Security
# Required 64+ char secret used to sign JWT / HMAC authentication tokens
SESSION_SECRET="replace_with_a_secure_random_64_char_secret_key"

# Environment Mode
NODE_ENV="development"

# Demo Mode Setting
# Set to 'true' in development to enable the instant demo persona switcher. Defaults to false in production for security.
ENABLE_DEMO_SWITCH="true"

# Server Port (defaults to 3000)
PORT=3000

# GEMINI_API_KEY: Optional server-side Gemini AI API key for drafting announcements & training summaries.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
