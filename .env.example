# =============================================================================
# StaffSync Environment Variables — Copy this file to .env and fill in values
# NEVER commit .env files with real credentials to version control.
# =============================================================================

# --- Database Configuration ---
# Required for production (Vercel). Use a MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Leave empty in local development to use the local persistent JSON storage fallback.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/staffsync?retryWrites=true&w=majority"

# --- Authentication & Session Security ---
# REQUIRED. Must be at least 64 characters of cryptographically random data.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In production (Vercel), process.exit(1) is called if this is missing or too short.
SESSION_SECRET="replace_with_a_secure_random_64_char_secret_key_minimum_64_characters_long"

# --- Environment Mode ---
# Set to "production" on Vercel (Vercel sets this automatically).
NODE_ENV="development"

# --- Demo Mode ---
# Controls whether the instant demo persona switcher is available.
# Set to "true" in development to enable it.
# In production (NODE_ENV=production), this MUST be explicitly set to "true" to enable it.
# Default behaviour in production: DISABLED (for security).
# Recommendation: Do NOT set this to "true" on your production Vercel deployment.
ENABLE_DEMO_SWITCH="false"

# --- Server Port (local development only) ---
# Vercel ignores this; it manages port binding itself.
PORT=3000

# --- Gemini AI (Optional) ---
# Server-side Gemini API key for AI announcement drafting.
# If absent or set to the placeholder value, the AI feature returns a graceful fallback template.
GEMINI_API_KEY="your_gemini_api_key_here"

# --- App URL (Optional) ---
# Public URL where this application is hosted. Used for self-referential links if needed.
# Vercel sets VERCEL_URL automatically; this is an optional override.
APP_URL="https://your-staffsync-deployment.vercel.app"
